{% macro appCards(apps, category, condition="category", conditionValue="") %}
  {% for app in apps %}
    {% set show = false %}
    {% if condition == "category" and app.category == category %}
      {% set show = true %}
    {% elif condition == "group" and app.footerGroup == conditionValue %}
      {% set show = true %}
    {% elif condition == "subcategory" and app.subCategory == conditionValue %}
      {% set show = true %}
    {% endif %}

    {% if show %}
      <li class="game-grid__item">
        <a aria-label="Open {{ app.name }}" class="game-card" data-category="{{ app.category }}" data-game="{{ app.id }}" href="{{ app.path }}">
          <span aria-hidden="true" class="game-card__icon">{{ app.emoji }}</span>
          <span class="game-card__title">{{ app.name }}</span>
          <span class="game-card__desc">{{ app.description }}</span>
        </a>
      </li>
    {% endif %}
  {% endfor %}
{% endmacro %}
